# agent-tutorial 环境变量模板
# 用法：复制这个文件为 .env，再把下面的值替换成你自己的。
#   cp .env.example .env
# .env 不会被提交（已在 .gitignore 中），可以放心填真实 Key。

# demo1 - demo11 都需要：DeepSeek Chat API Key
DEEPSEEK_API_KEY=你的 DeepSeek API Key

# 只有 demo10（RAG Agent）需要：智谱 API Key，用于 embedding-3 生成向量
ZHIPU_API_KEY=你的智谱 API Key

# 只有 demo10（RAG Agent）需要：PostgreSQL 数据库连接信息
# PGVECTOR_HOST 填公网访问地址，PGVECTOR_PASSWORD 填数据库密码
PGVECTOR_HOST=你的 PostgreSQL 公网访问地址
PGVECTOR_PASSWORD=你的数据库密码
